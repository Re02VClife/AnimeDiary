{
  "name": "anime-diary",
  "version": "1.0.23",
  "description": "番剧评分管理系统 - 记录你与每部番的相遇",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dev:web": "vite",
    "build:api": "esbuild server/api-routes.ts --bundle --platform=node --format=cjs --target=node20 --outfile=server/api-routes.cjs --external:xlsx --external:adm-zip --external:electron",
    "build": "npm run build:api && vite build && electron-builder",
    "build:dir": "npm run build:api && vite build && electron-builder --dir",
    "update:pack": "npm run build:api && node scripts/build-web-update.js",
    "update:serve": "node scripts/serve-updates.js",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "screenshot-desktop": "^1.15.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.5.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@types/adm-zip": "^0.5.8",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "antd": "^5.22.0",
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.13",
    "echarts": "^5.5.1",
    "echarts-for-react": "^3.0.2",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "gifenc": "^1.0.3",
    "jsdom": "^25.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^2.1.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.animediary.app",
    "productName": "AnimeDiary",
    "afterPack": "scripts/after-pack.js",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/api-routes.cjs",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.ico",
      "artifactName": "AnimeDiary-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AnimeDiary",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "http://127.0.0.1:8787/updates/"
      }
    ]
  }
}
